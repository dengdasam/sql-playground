<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SqlPlayground</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 本地单用户查询服务：工作站 GC 更省内存，服务器 GC 的吞吐优势在这里用不上 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- 三种数据库驱动；运行时各自自带原生引擎，无需本机安装客户端 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- 数据库文件随发布复制；.db 不在 Web SDK 默认通配里，必须显式 Include（Update 对未包含项无效） -->
    <Content Include="wms.db" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
